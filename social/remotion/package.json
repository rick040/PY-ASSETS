{
  "name": "parkingyou-social-remotion",
  "private": true,
  "version": "0.1.0",
  "description": "ParkingYou Instagram reels built from PY-ASSETS",
  "scripts": {
    "sync-assets": "node scripts/sync-assets.mjs",
    "prestudio": "npm run sync-assets",
    "studio": "remotion studio",
    "render:ig-002": "remotion render PY-R1-IG-002-Reel renders/IG-002-hofplein-reel.mp4 --props=src/items/IG-002.json",
    "render:ig-002:feed": "remotion render PY-R1-IG-002-Feed renders/IG-002-hofplein-feed.mp4 --props=src/items/IG-002.json",
    "still:ig-002": "remotion still PY-R1-IG-002-Reel renders/IG-002-hofplein-cover.png --frame=60 --props=src/items/IG-002.json",
    "typecheck": "tsc --noEmit",
    "render:ig-021": "remotion render PY-R7-IG-021-Reel renders/IG-021-rondjes-rijden-reel.mp4 --props=src/items/IG-021.json",
    "render:ig-021:feed": "remotion render PY-R7-IG-021-Feed renders/IG-021-rondjes-rijden-feed.mp4 --props=src/items/IG-021.json",
    "still:ig-021": "remotion still PY-R7-IG-021-Reel renders/IG-021-rondjes-rijden-cover.png --frame=40 --props=src/items/IG-021.json",
    "render:ig-064": "remotion render PY-R5-IG-064-Reel renders/IG-064-parkeertypes-reel.mp4 --props=src/items/IG-064.json",
    "render:ig-064:feed": "remotion render PY-R5-IG-064-Feed renders/IG-064-parkeertypes-feed.mp4 --props=src/items/IG-064.json",
    "still:ig-064": "remotion still PY-R5-IG-064-Reel renders/IG-064-parkeertypes-cover.png --frame=20 --props=src/items/IG-064.json",
    "render:all": "npm run sync-assets && for i in ig-002 ig-017 ig-018 ig-021 ig-028 ig-064; do npm run render:$i -- $B && npm run render:$i:feed -- $B && npm run still:$i -- $B; done",
    "prerender:ig-002": "npm run sync-assets",
    "render:ig-017": "remotion render PY-R2-IG-017-Reel renders/IG-017-hofplein-drie-prijzen-reel.mp4 --props=src/items/IG-017.json",
    "render:ig-017:feed": "remotion render PY-R2-IG-017-Feed renders/IG-017-hofplein-drie-prijzen-feed.mp4 --props=src/items/IG-017.json",
    "still:ig-017": "remotion still PY-R2-IG-017-Reel renders/IG-017-hofplein-drie-prijzen-cover.png --frame=40 --props=src/items/IG-017.json",
    "render:ig-018": "remotion render PY-R2-IG-018-Reel renders/IG-018-rijswijk-drie-prijzen-reel.mp4 --props=src/items/IG-018.json",
    "render:ig-018:feed": "remotion render PY-R2-IG-018-Feed renders/IG-018-rijswijk-drie-prijzen-feed.mp4 --props=src/items/IG-018.json",
    "still:ig-018": "remotion still PY-R2-IG-018-Reel renders/IG-018-rijswijk-drie-prijzen-cover.png --frame=40 --props=src/items/IG-018.json",
    "render:ig-028": "remotion render PY-R4-IG-028-Reel renders/IG-028-reserveren-in-3-stappen-reel.mp4 --props=src/items/IG-028.json",
    "render:ig-028:feed": "remotion render PY-R4-IG-028-Feed renders/IG-028-reserveren-in-3-stappen-feed.mp4 --props=src/items/IG-028.json",
    "still:ig-028": "remotion still PY-R4-IG-028-Reel renders/IG-028-reserveren-in-3-stappen-cover.png --frame=40 --props=src/items/IG-028.json"
  },
  "dependencies": {
    "@remotion/cli": "4.0.534",
    "@remotion/fonts": "4.0.534",
    "@remotion/transitions": "4.0.534",
    "@remotion/zod-types": "4.0.534",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "remotion": "4.0.534",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@remotion/renderer": "4.0.534",
    "@types/react": "19.1.10",
    "typescript": "5.8.3"
  }
}
